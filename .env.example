# Copy to .env. Every value below is a placeholder.

PORT=3000

# MongoDB. Prisma needs a replica set (MongoDB Atlas, or a local
# single-node replica set; see the README).
DATABASE_URL="mongodb://localhost:27017/chatty?replicaSet=rs0&directConnection=true"

# Signs access, refresh and password-reset tokens. Required: the app
# refuses to start without it.
JWT_SECRET=replace-with-a-long-random-string

# In production, the comma-separated origins allowed to call the HTTP API.
NODE_ENV=development
ALLOWED_ORIGINS=https://chat.example.com
